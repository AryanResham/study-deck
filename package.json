{
  "name": "studydeck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn notes or a topic into flashcards and quizzes with an AI model.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "concurrently -k -n api,web -c blue,green \"npm:server\" \"npm:client\"",
    "server": "node --watch --env-file-if-exists=.env server/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
